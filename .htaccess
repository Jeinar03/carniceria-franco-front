# Ruteo de la SPA Angular: cualquier ruta que no sea un archivo/carpeta real
# se sirve con index.html para que el router del cliente la resuelva.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# index.html nunca se cachea (así los clientes reciben el bundle nuevo tras un deploy).
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
